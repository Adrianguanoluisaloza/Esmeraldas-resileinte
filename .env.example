# Runtime
APP_ENV=development
PUBLIC_APP_URL=http://localhost:4321

# OpenStreetMap OAuth 2.0
OSM_CLIENT_ID=replace_with_osm_client_id
OSM_CLIENT_SECRET=replace_with_osm_client_secret
OSM_REDIRECT_URI=http://localhost:8787/auth/osm/callback
OSM_SCOPES=read_prefs

# Map tiles: use a provider-approved URL in production
PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILES_API_KEY=

# Session and server-side security
SESSION_SECRET=replace_with_a_long_random_secret

# Cloudflare Pages / Workers / CI
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_PAGES_PROJECT=replace_with_pages_project_name
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Mobile OAuth callback; client secrets must never be shipped in the app
MOBILE_OAUTH_REDIRECT_URI=com.esmeralda.app://oauth/callback

# Android distribution (CI only)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# iOS distribution (CI only)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
