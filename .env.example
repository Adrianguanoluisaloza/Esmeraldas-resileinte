# Runtime
APP_ENV=development
PUBLIC_APP_URL=http://localhost:4321

# Web -> API (la web solo ve variables PUBLIC_)
PUBLIC_API_URL=http://localhost:3000

# Backend apps/api + docker-compose.yml (Oracle Cloud)
# memoria = demo sin base; postgres = PostgreSQL + PostGIS
ALMACEN=memoria
POSTGRES_DB=resiliente
POSTGRES_USER=resiliente
POSTGRES_PASSWORD=replace_with_a_long_random_password
# Usuario restringido de la API (sin DELETE ni DDL). Distinta a POSTGRES_PASSWORD.
APP_DB_PASSWORD=replace_with_another_long_random_password
DATABASE_URL=postgres://resiliente_app:replace_with_another_long_random_password@localhost:5432/resiliente
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_MINUTOS=720
# Orígenes exactos que pueden llamar a la API desde un navegador (agregar aquí la URL del túnel si se usa).
# Fuera de producción también se acepta http://localhost con cualquier puerto.
CORS_ORIGENES=http://localhost:4321,https://esmeraldas-resiliente.eliasadrianlozadaguanoluisa.workers.dev
API_PUERTO=3000
API_ESCUCHA=127.0.0.1
CONFIAR_EN_PROXY=false
LIMITE_ESCRITURAS_MINUTO=120
# Solo para npm run usuarios:demo (cuentas de la demo)
DEMO_PASSWORD=

# OpenStreetMap OAuth 2.0
OSM_CLIENT_ID=replace_with_osm_client_id
OSM_CLIENT_SECRET=replace_with_osm_client_secret
OSM_REDIRECT_URI=http://localhost:8787/auth/osm/callback
OSM_SCOPES=read_prefs

# Map tiles: use a provider-approved URL in production
PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILES_API_KEY=

# Session and server-side security
SESSION_SECRET=replace_with_a_long_random_secret

# Cloudflare Pages / Workers / CI
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_PAGES_PROJECT=replace_with_pages_project_name
CLOUDFLARE_API_TOKEN=

# Mobile OAuth callback; client secrets must never be shipped in the app
MOBILE_OAUTH_REDIRECT_URI=com.esmeralda.app://oauth/callback

# Android distribution (CI only)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# iOS distribution (CI only)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
