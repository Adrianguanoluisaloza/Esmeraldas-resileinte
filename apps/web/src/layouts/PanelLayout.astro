---
/**
 * Layout del panel autenticado: barra lateral por rol + barra superior con la sesión.
 * Uso:
 *   <PanelLayout titulo="Reportes" roles={['operador_911', 'admin']}> ... </PanelLayout>
 * `roles` = quién puede abrir la página. Si otra persona entra, se la manda a su inicio.
 * Esto es comodidad de interfaz, NO seguridad: la API vuelve a validar el rol en cada petición.
 */
import { LogOut, Menu, MoonStar } from 'lucide-react';
import BaseLayout from './BaseLayout.astro';
import IconoNav from '../components/panel/IconoNav.astro';
import { NAVEGACION } from '../config/navegacion';
import type { RolUsuario } from '../lib/auth';
import '../styles/panel.css';

interface Props {
  titulo: string;
  descripcion?: string;
  roles?: RolUsuario[];
  /** Quita el padding del contenido (pantallas de mapa a todo lo ancho). */
  completo?: boolean;
}

const { titulo, descripcion, roles = ['ciudadano', 'operador_911', 'bomberos', 'policia', 'admin'], completo = false } = Astro.props;
const rutaActual = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <div class="pn" data-roles-pagina={roles.join(',')}>
    <aside class="pn-lateral" id="pn-lateral" aria-label="Menú principal">
      <a class="pn-marca" href="/">
        <span class="pn-marca__logo" aria-hidden="true"></span>
        <strong class="pn-marca__texto">Esmeraldas Resiliente</strong>
      </a>

      <nav class="pn-nav">
        {NAVEGACION.map((grupo) => (
          <div class="pn-grupo" data-roles={[...new Set(grupo.items.flatMap((i) => i.roles))].join(',')}>
            <div class="pn-grupo__titulo">{grupo.titulo}</div>
            <ul>
              {grupo.items.map((item) => (
                <li data-roles={item.roles.join(',')}>
                  <a
                    class="pn-enlace"
                    href={item.ruta}
                    aria-current={rutaActual === item.ruta ? 'page' : undefined}
                  >
                    <IconoNav nombre={item.icono} />
                    <span>{item.etiqueta}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="pn-lateral__pie">
        <button class="er-btn er-btn--fantasma er-btn--sm er-btn--bloque" type="button" id="pn-tema">
          <MoonStar size={16} aria-hidden="true" />
          <span id="pn-tema-texto">Automático</span>
        </button>
      </div>
    </aside>

    <div class="pn-velo" id="pn-velo" hidden></div>

    <div class="pn-principal">
      <header class="pn-superior">
        <button class="er-btn er-btn--fantasma er-btn--icono pn-abrir" type="button" id="pn-abrir" aria-controls="pn-lateral" aria-expanded="false">
          <Menu size={20} aria-hidden="true" />
          <span class="er-sr">Abrir menú</span>
        </button>
        <h1 class="pn-titulo">{titulo}</h1>
        <div class="pn-sesion">
          <span class="pn-sesion__nombre" id="pn-nombre"></span>
          <span class="er-insignia" id="pn-rol"></span>
          <button class="er-btn er-btn--secundario er-btn--sm" type="button" id="pn-salir">
            <LogOut size={16} aria-hidden="true" />
            <span>Salir</span>
          </button>
        </div>
      </header>

      <main id="contenido" class:list={['pn-contenido', { 'pn-contenido--completo': completo }]}>
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import { cerrarSesion, obtenerSesionActual, obtenerTokenActual } from '../lib/auth';
  import { inicioSegunRol } from '../config/navegacion';

  const ETIQUETA_ROL: Record<string, string> = { ciudadano: 'Ciudadano', operador_911: 'ECU 911', bomberos: 'Bomberos', policia: 'Policía', admin: 'Administrador' };

  const raiz = document.querySelector<HTMLElement>('.pn')!;
  const sesion = obtenerSesionActual();

  if (!sesion) {
    location.replace(`/login?volver=${encodeURIComponent(location.pathname)}`);
  } else {
    const permitidos = (raiz.dataset.rolesPagina ?? '').split(',');
    if (!permitidos.includes(sesion.rol)) location.replace(inicioSegunRol(sesion.rol));

    // Menú: deja solo lo que corresponde al rol.
    document.querySelectorAll<HTMLElement>('[data-roles]').forEach((el) => {
      if (!(el.dataset.roles ?? '').split(',').includes(sesion.rol)) el.remove();
    });

    document.getElementById('pn-nombre')!.textContent = sesion.nombre;
    document.getElementById('pn-rol')!.textContent = ETIQUETA_ROL[sesion.rol] ?? sesion.rol;

    // Sesión vencida: se cierra sola.
    const exp = leerExp(obtenerTokenActual());
    if (exp) setTimeout(salir, Math.max(0, exp * 1000 - Date.now()));
  }

  function leerExp(token: string | null): number | null {
    try {
      const carga = JSON.parse(atob((token ?? '').split('.')[1]!.replace(/-/g, '+').replace(/_/g, '/')));
      return Number.isInteger(carga.exp) ? carga.exp : null;
    } catch {
      return null;
    }
  }

  function salir() {
    cerrarSesion();
    location.replace('/login');
  }
  document.getElementById('pn-salir')!.addEventListener('click', salir);

  // Menú lateral en móvil.
  const lateral = document.getElementById('pn-lateral')!;
  const velo = document.getElementById('pn-velo')!;
  const abrir = document.getElementById('pn-abrir')!;
  const alternar = (abierto: boolean) => {
    lateral.classList.toggle('pn-lateral--abierto', abierto);
    velo.hidden = !abierto;
    abrir.setAttribute('aria-expanded', String(abierto));
  };
  abrir.addEventListener('click', () => alternar(!lateral.classList.contains('pn-lateral--abierto')));
  velo.addEventListener('click', () => alternar(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && alternar(false));

  // Tema: automático -> claro -> oscuro.
  const ORDEN = ['auto', 'light', 'dark'] as const;
  const TEXTO = { auto: 'Automático', light: 'Claro', dark: 'Oscuro' };
  const leerTema = (): (typeof ORDEN)[number] => {
    try {
      const t = localStorage.getItem('er-tema');
      return t === 'light' || t === 'dark' ? t : 'auto';
    } catch {
      return 'auto';
    }
  };
  const textoTema = document.getElementById('pn-tema-texto')!;
  textoTema.textContent = TEXTO[leerTema()];
  document.getElementById('pn-tema')!.addEventListener('click', () => {
    const siguiente = ORDEN[(ORDEN.indexOf(leerTema()) + 1) % ORDEN.length]!;
    try {
      if (siguiente === 'auto') localStorage.removeItem('er-tema');
      else localStorage.setItem('er-tema', siguiente);
    } catch {}
    if (siguiente === 'auto') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = siguiente;
    textoTema.textContent = TEXTO[siguiente];
  });
</script>
