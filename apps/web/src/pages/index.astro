---
import { Bell, ClipboardList, HandHeart, Map, Siren, Tent, TriangleAlert, Users } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraSitio from '../components/sitio/CabeceraSitio.astro';
import '../styles/panel.css';
import '../styles/sitio.css';

const modulos = [
  { icono: Map, titulo: 'Mapa de riesgos', texto: 'Zonas inundables, vías y albergues sobre OpenStreetMap.' },
  { icono: Siren, titulo: 'Reporte ciudadano', texto: 'GPS, foto y familia afectada. Funciona sin señal.' },
  { icono: ClipboardList, titulo: 'Centro de operaciones', texto: 'Incidentes en tiempo real, estados y alertas por sector.' },
  { icono: Tent, titulo: 'Albergues', texto: 'Cupo con semáforo y el más cercano con espacio.' },
  { icono: HandHeart, titulo: 'Asistencia', texto: 'Agua, alimentos y medicinas: pendientes y entregas.' },
  { icono: TriangleAlert, titulo: 'Priorización', texto: 'Sectores ordenados por gravedad, personas y recurrencia.' },
];

const preguntas = [
  '¿Qué está sucediendo?',
  '¿Dónde ocurren las emergencias?',
  '¿Cuántas personas están afectadas?',
  '¿Qué sectores son prioritarios?',
  '¿Qué vías están interrumpidas?',
  '¿Dónde hay albergues disponibles?',
  '¿Qué recursos movilizar?',
  '¿Cómo coordinar la atención?',
];
---

<BaseLayout titulo="Inicio">
  <CabeceraSitio />

  <main id="contenido">
    <section class="st-heroe">
      <div class="st-heroe__texto">
        <h1>Gestión de emergencias para Esmeraldas</h1>
        <p>Reportes ciudadanos, mapa de riesgos y coordinación del COE en una sola plataforma.</p>
        <div class="st-acciones">
          <a class="er-btn er-btn--primario er-btn--lg" href="/login">Ingresar</a>
          <a class="er-btn er-btn--secundario er-btn--lg" href="#modulos">Ver módulos</a>
        </div>
      </div>

      <div class="st-ilustracion" aria-hidden="true">
        <div class="st-anillo st-anillo--1"></div>
        <div class="st-anillo st-anillo--2"></div>
        <div class="st-anillo st-anillo--3"></div>
        <div class="st-nucleo"><span class="pn-marca__logo"></span></div>
        <div class="st-ficha st-ficha--a">
          <span class="er-insignia er-insignia--grav-critica"><span class="er-insignia__punto"></span>Crítica</span>
          <strong>Inundación</strong><span>Isla Piedad</span>
        </div>
        <div class="st-ficha st-ficha--b">
          <span class="er-insignia er-insignia--cupo-verde"><span class="er-insignia__punto"></span>Con cupo</span>
          <strong>Albergue</strong><span>Coliseo</span>
        </div>
        <div class="st-ficha st-ficha--c">
          <Bell size={16} />
          <strong>Alerta por sector</strong><span>Río Teaone</span>
        </div>
        <div class="st-ficha st-ficha--d">
          <Users size={16} />
          <strong>Familia reportada</strong><span>20 de Noviembre</span>
        </div>
      </div>
    </section>

    <section class="st-seccion" id="modulos">
      <h2>Módulos</h2>
      <ul class="st-modulos">
        {modulos.map(({ icono: Icono, titulo, texto }) => (
          <li class="er-tarjeta st-modulo">
            <Icono size={22} aria-hidden="true" />
            <strong>{titulo}</strong>
            <span>{texto}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="st-seccion st-seccion--alterna" id="escenario">
      <h2>Escenario Jueves 06:00</h2>
      <ol class="st-preguntas">
        {preguntas.map((p) => <li>{p}</li>)}
      </ol>
    </section>
  </main>

  <footer class="st-pie">
    <span>Esmeraldas Resiliente · Hackathon UTLVTE 2026</span>
    <span>No reemplaza al ECU 911 ni a las alertas oficiales.</span>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
    <a href="/legal">Legal y licencias</a>
  </footer>
</BaseLayout>
