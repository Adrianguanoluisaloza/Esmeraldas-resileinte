---
import { PanelOperaciones } from '../components/PanelOperaciones';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Centro de Operaciones 911 y Gestión de Emergencias por El Niño en Esmeraldas - Plataforma Offline-First." />
    <title>ESMERALDAS RESILIENTE — Centro de Operaciones 911</title>
  </head>
  <body>
    <!-- Encabezado Principal del Centro de Operaciones -->
    <header class="navbar">
      <div class="navbar-brand">
        <div class="logo-indicador"></div>
        <div>
          <h1 class="titulo-sistema">ESMERALDAS RESILIENTE</h1>
          <p class="subtitulo-sistema">Centro de Operaciones de Emergencia (COE 911) · Esmeraldas, Ecuador</p>
        </div>
      </div>

      <div class="navbar-status">
        <div class="status-item">
          <span class="status-dot dot-online"></span>
          <span>Red: Conectada</span>
        </div>
        <div class="status-item">
          <span>Escenario: <strong>Jueves 06:00 UTC</strong></span>
        </div>
        <div class="badge-rol">OPERADOR 911</div>
      </div>
    </header>

    <!-- Contenido Principal: Isla interactiva de React con el Mapa Leaflet -->
    <main class="main-layout">
      <PanelOperaciones client:only="react">
        <!-- Esqueleto de carga accesible mientras se inicializa Leaflet en el cliente -->
        <div slot="fallback" class="skeleton-mapa">
          <div class="spinner"></div>
          <p>Cargando visualización geoespacial de Esmeraldas y OpenStreetMap...</p>
        </div>
      </PanelOperaciones>
    </main>

    <!-- Footer con Atribución Obligatoria -->
    <footer class="footer">
      <div>
        Plataforma Esmeraldas Resiliente 2026 · Desarrollado para respuesta ante el Fenómeno de El Niño
      </div>
      <div>
        Datos cartográficos: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© Colaboradores de OpenStreetMap</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-page: #090d16;
    --bg-card: #0f172a;
    --bg-card-hover: #1e293b;
    --border-color: #334155;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --accent-blue: #0284c7;
    --danger: #dc2626;
    --warning: #d97706;
    --success: #16a34a;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-page);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* Encabezado */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    background-color: #0b1329;
    border-bottom: 1px solid var(--border-color);
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-indicador {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background-color: var(--danger);
    box-shadow: 0 0 10px var(--danger);
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .titulo-sistema {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  .subtitulo-sistema {
    font-size: 11px;
    color: var(--text-secondary);
  }

  .navbar-status {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
  }

  .dot-online {
    background-color: var(--success);
    box-shadow: 0 0 6px var(--success);
  }

  .badge-rol {
    background-color: #1e293b;
    border: 1px solid var(--border-color);
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: #38bdf8;
  }

  /* Layout Principal */
  .main-layout {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
    gap: 12px;
  }

  /* Esqueleto de carga para el mapa */
  .skeleton-mapa {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 540px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    color: var(--text-secondary);
    gap: 12px;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--border-color);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Banner de Alerta */
  .alerta-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: rgba(220, 38, 38, 0.15);
    border: 1px solid rgba(220, 38, 38, 0.4);
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .alerta-badge {
    background-color: var(--danger);
    color: white;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .alerta-texto {
    color: #fca5a5;
  }

  /* KPIs */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 12px;
  }

  .kpi-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 14px 18px;
  }

  .kpi-critico {
    border-color: rgba(220, 38, 38, 0.5);
    background: linear-gradient(180deg, rgba(220, 38, 38, 0.08) 0%, var(--bg-card) 100%);
  }

  .kpi-albergue {
    border-color: rgba(22, 163, 74, 0.4);
  }

  .kpi-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .kpi-value {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
  }

  .kpi-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* Barra de Filtros */
  .filtros-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 12px;
  }

  .filtros-grupo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .filtro-label {
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .filtro-select {
    background-color: #1e293b;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    outline: none;
  }

  .filtros-capas {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  .capa-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    cursor: pointer;
  }

  /* Grid Central */
  .contenido-grid {
    display: grid;
    grid-template-columns: 320px 1fr 340px;
    gap: 12px;
    flex: 1;
    min-height: 560px;
  }

  @media (max-width: 1200px) {
    .contenido-grid {
      grid-template-columns: 280px 1fr;
    }
    .panel-detalle {
      grid-column: span 2;
    }
  }

  @media (max-width: 800px) {
    .contenido-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Sidebar Lista */
  .sidebar-incidentes {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-header h3 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-contador {
    background-color: #1e293b;
    color: #38bdf8;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
  }

  .lista-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 560px;
  }

  .tarjeta-incidente {
    background-color: #162032;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tarjeta-incidente:hover {
    background-color: var(--bg-card-hover);
    border-color: #475569;
  }

  .tarjeta-activa {
    background-color: #1e293b;
    border-color: var(--accent-blue) !important;
    box-shadow: 0 0 0 1px var(--accent-blue);
  }

  .tarjeta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .badge-gravedad {
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    color: white;
  }

  .badge-critica { background-color: var(--danger); }
  .badge-alta { background-color: var(--warning); }
  .badge-media { background-color: #ca8a04; }
  .badge-baja { background-color: #2563eb; }

  .tarjeta-tiempo {
    font-size: 10px;
    color: var(--text-muted);
  }

  .tarjeta-titulo {
    font-size: 12px;
    color: #f1f5f9;
    display: block;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .tarjeta-sector {
    font-size: 11px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .tarjeta-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
  }

  .badge-estado {
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .estado-pendiente { background-color: rgba(220, 38, 38, 0.2); color: #f87171; }
  .estado-en_proceso { background-color: rgba(217, 119, 6, 0.2); color: #fbbf24; }
  .estado-atendido { background-color: rgba(22, 163, 74, 0.2); color: #4ade80; }

  .tarjeta-afectados {
    color: #cbd5e1;
    font-weight: 600;
  }

  /* Mapa Wrapper */
  .mapa-wrapper {
    position: relative;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .mapa-header-info {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 400;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .mapa-tag {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(4px);
    font-size: 10px;
    font-weight: 800;
    color: #f8fafc;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .mapa-atribucion-nota {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(4px);
    font-size: 9px;
    color: var(--text-muted);
    padding: 4px 8px;
    border-radius: 6px;
  }

  /* Panel de Detalle */
  .panel-detalle {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .detalle-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detalle-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .detalle-id {
    font-size: 10px;
    color: var(--text-muted);
    font-family: monospace;
  }

  .detalle-titulo {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  .detalle-sector {
    font-size: 12px;
    color: #38bdf8;
  }

  .detalle-coords {
    font-size: 11px;
    color: var(--text-muted);
    background-color: #162032;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .seccion-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .seccion-texto {
    font-size: 12px;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .detalle-familias {
    background-color: #162032;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px;
  }

  .familia-stats {
    display: flex;
    gap: 12px;
    font-size: 11px;
    margin-bottom: 8px;
  }

  .f-item {
    color: var(--text-secondary);
  }

  .f-item strong {
    color: #ffffff;
  }

  .necesidades-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-necesidad {
    background-color: rgba(220, 38, 38, 0.2);
    border: 1px solid rgba(220, 38, 38, 0.4);
    color: #fca5a5;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .acciones-operador {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border-color);
  }

  .botones-accion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 6px;
  }

  .btn-despachar {
    background-color: var(--accent-blue);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-atendido {
    background-color: var(--success);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-despachar:disabled, .btn-atendido:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .detalle-vacio {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-muted);
    font-size: 12px;
    text-align: center;
    padding: 24px;
  }

  /* Footer */
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 24px;
    background-color: #0b1329;
    border-top: 1px solid var(--border-color);
    font-size: 11px;
    color: var(--text-muted);
  }

  .footer a {
    color: var(--accent-blue);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }
</style>
