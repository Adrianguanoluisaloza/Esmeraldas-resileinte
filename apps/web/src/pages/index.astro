---
import { Flame, Phone, Shield, Users } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraSitio from '../components/sitio/CabeceraSitio.astro';
import '../styles/panel.css';
import '../styles/sitio.css';

const capacidades = [
  ['Mapa de riesgos', 'Zonas, vías y albergues sobre OpenStreetMap.'],
  ['Funciona sin señal', 'El reporte se guarda y sale al reconectar.'],
  ['Tiempo real', 'Cada reporte llega al panel en segundos.'],
  ['Por institución', 'Cada rol ve lo que le corresponde.'],
];

const pasos = [
  ['Reporta', 'Tipo de emergencia, ubicación, foto y familia afectada. Sin señal, el reporte espera en el celular.'],
  ['Llega a quien corresponde', 'Cada institución recibe en su panel, en tiempo real, los incidentes que atiende.'],
  ['Se atiende y se sigue', 'Despacho, estado e historial quedan registrados para el centro de operaciones y para quien reportó.'],
];

const actores = [
  { icono: Users, nombre: 'Ciudadanía', texto: 'Reporta, sigue su caso y encuentra el albergue con cupo más cercano.' },
  { icono: Phone, nombre: 'ECU 911', texto: 'Ve todo el territorio, despacha y emite alertas por sector.' },
  { icono: Flame, nombre: 'Bomberos', texto: 'Atiende inundaciones, deslizamientos, rescates y viviendas dañadas.' },
  { icono: Shield, nombre: 'Policía', texto: 'Atiende vías bloqueadas y rescates, y actualiza el estado de las vías.' },
];
---

<BaseLayout titulo="Inicio">
  <CabeceraSitio />

  <main id="contenido">
    <section class="st-heroe">
      <div class="st-heroe__texto">
        <h1>Del celular del ciudadano al mapa del COE.</h1>
        <p class="st-bajada">Reportes con GPS y foto, incluso sin señal. ECU 911, Bomberos y Policía coordinan sobre el mismo mapa.</p>
        <div class="st-acciones">
          <a class="er-btn er-btn--primario er-btn--lg" href="/login">Ingresar</a>
          <a class="er-btn er-btn--secundario er-btn--lg" href="/app">Conocer la app</a>
        </div>
      </div>
      <video id="st-video" class="st-video" autoplay muted loop playsinline preload="metadata" poster="/video/panel.jpg" aria-label="Demostración del panel: un reporte ciudadano llega al mapa, se despacha y se marca como atendido">
        <source src="/video/panel.mp4" type="video/mp4" />
      </video>
    </section>

    <ul class="st-franja">
      {capacidades.map(([titulo, texto]) => <li><strong>{titulo}</strong><span>{texto}</span></li>)}
    </ul>

    <section class="st-seccion" id="como-funciona">
      <div class="st-encabezado"><h2>Un reporte, una respuesta coordinada.</h2></div>
      <ol class="st-pasos">
        {pasos.map(([titulo, texto]) => <li><strong>{titulo}</strong><span>{texto}</span></li>)}
      </ol>
    </section>

    <section class="st-seccion" id="instituciones">
      <div class="st-encabezado"><h2>Cada quien ve lo que le corresponde.</h2></div>
      <ul class="st-actores">
        {actores.map(({ icono: Icono, nombre, texto }) => <li><Icono size={18} aria-hidden="true" /><strong>{nombre}</strong><span>{texto}</span></li>)}
      </ul>
    </section>
  </main>

  <footer class="st-pie">
    <span>Esmeraldas Resiliente. No reemplaza al ECU 911: en una emergencia, llama al 911.</span>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
    <a href="/legal">Legal y licencias</a>
  </footer>
</BaseLayout>

<script is:inline>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('st-video')?.pause();
</script>
