---
import { Download } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraSitio from '../components/sitio/CabeceraSitio.astro';
import { PortadaMapa } from '../components/PortadaMapa';
import { URL_APK } from '../config/enlaces';
import '../styles/panel.css';
import '../styles/operaciones.css';
import '../styles/sitio.css';

const preguntas = [
  ['¿Qué está sucediendo en el territorio?', 'Mapa operativo'],
  ['¿Dónde se producen las emergencias?', 'Reportes georreferenciados'],
  ['¿Cuántas personas y familias están afectadas?', 'Estadísticas del COE'],
  ['¿Qué sectores requieren atención prioritaria?', 'Priorización por sector'],
  ['¿Qué vías se encuentran interrumpidas?', 'Capa de vías'],
  ['¿Dónde existen albergues disponibles?', 'Semáforo de cupo'],
  ['¿Qué recursos deben movilizarse?', 'Asistencia e inventario'],
  ['¿Cómo coordinar la atención de incidentes?', 'Estados e historial en tiempo real'],
];
---

<BaseLayout titulo="Inicio">
  <CabeceraSitio />

  <main id="contenido">
    <section class="st-heroe">
      <div class="st-heroe__texto">
        <h1>Del celular del ciudadano al mapa del COE.</h1>
        <p class="st-bajada">Quien necesita ayuda reporta aunque no tenga señal. El COE ve dónde es, cuántas personas son y qué hace falta.</p>
        <div class="st-acciones">
          <a class="er-btn er-btn--primario er-btn--lg" href="/login">Ingresar</a>
          <a class="er-btn er-btn--secundario er-btn--lg" href={URL_APK}><Download aria-hidden="true" /> Descargar app Android</a>
        </div>
        <p class="st-nota">No reemplaza al ECU 911. En una emergencia, llama al 911.</p>
      </div>
      <PortadaMapa client:only="react">
        <div slot="fallback" class="st-tablero st-tablero--cargando"></div>
      </PortadaMapa>
    </section>

    <section class="st-seccion" id="escenario">
      <div class="st-encabezado">
        <h2>Jueves, 06:00. Ocho preguntas, una respuesta cada una.</h2>
        <p>Seis eventos simultáneos tras una noche de lluvia intensa. Esto debe saber el COE en los primeros minutos.</p>
      </div>
      <ol class="st-indice">
        {preguntas.map(([pregunta, respuesta]) => (
          <li><span class="st-indice__pregunta">{pregunta}</span><span class="st-indice__respuesta">{respuesta}</span></li>
        ))}
      </ol>
    </section>

    <section class="st-seccion st-app" id="app">
      <div class="st-encabezado">
        <h2>La app sigue funcionando sin señal.</h2>
        <p>Guarda el reporte y la foto en el celular, ubica por satélite y lo envía cuando vuelve la conexión.</p>
      </div>
      <div class="st-app__accion">
        <a class="er-btn er-btn--primario er-btn--lg" href={URL_APK}><Download aria-hidden="true" /> Descargar APK</a>
        <p class="st-nota">Android. Al ser un prototipo, el teléfono pedirá permitir la instalación.</p>
      </div>
    </section>
  </main>

  <footer class="st-pie">
    <span>Esmeraldas Resiliente · Hackathon UTLVTE 2026</span>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
    <a href="/legal">Legal y licencias</a>
  </footer>
</BaseLayout>
