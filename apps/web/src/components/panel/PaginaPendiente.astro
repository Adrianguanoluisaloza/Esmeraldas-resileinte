---
/**
 * Estado estándar para pantallas cuyo endpoint aún responde 501 (NO_IMPLEMENTADO).
 * Al implementar la función: reemplazar este componente por la isla real y quitar `pendiente` en navegacion.ts.
 */
import { CircleDashed } from 'lucide-react';

interface Props {
  titulo: string;
  texto: string;
  /** Endpoint del contrato que falta, para que quien lo implemente sepa dónde mirar. */
  endpoint: string;
}

const { titulo, texto, endpoint } = Astro.props;
---

<div class="er-vacio">
  <CircleDashed aria-hidden="true" />
  <div class="er-vacio__titulo">{titulo}</div>
  <p class="er-vacio__texto">{texto}</p>
  <code class="pn-sub">{endpoint}</code>
</div>
