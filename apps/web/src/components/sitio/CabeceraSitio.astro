---
/** Cabecera de las páginas públicas (portada y acceso). */
import { Download } from 'lucide-react';
import { URL_APK } from '../../config/enlaces';
const enPaginaApp = Astro.url.pathname.replace(/\/+$/, '') === '/app';
---

<header class="st-cabecera">
  <a class="pn-marca" href="/">
    <span class="pn-marca__logo" aria-hidden="true"></span>
    <strong class="pn-marca__texto">Esmeraldas Resiliente</strong>
  </a>
  <nav class="st-nav" aria-label="Principal">
    <a href="/#como-funciona">Cómo funciona</a>
    <a href="/#instituciones">Instituciones</a>
    <a href="/app">App móvil</a>
  </nav>
  {!enPaginaApp && <a class="er-btn st-btn-oscuro" href={URL_APK}><Download size={15} aria-hidden="true" /> Descargar app</a>}
</header>
