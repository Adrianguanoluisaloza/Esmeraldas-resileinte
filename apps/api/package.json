{
  "name": "esmeraldas-resiliente-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:db": "node --import tsx --test test/api.test.ts",
    "usuarios:demo": "tsx src/scripts/crearUsuariosDemo.ts",
    "ci": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@hono/node-ws": "^1.3.1",
    "firebase-admin": "13.10.0",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
